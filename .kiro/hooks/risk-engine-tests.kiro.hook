{
  "enabled": true,
  "name": "Risk engine tests on save",
  "description": "When a file in the risk engine folder is saved, run the unit and property-based tests for the risk engine.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "lib/risk-engine/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file in lib/risk-engine/ was just saved. Run the risk engine unit and property-based tests with `npx vitest run lib/risk-engine`. If any test fails, report the failing test names and the counterexample (for property tests), then stop. Do not change code unless asked."
  }
}
